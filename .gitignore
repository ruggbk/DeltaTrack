.env
# Private operator/AI notes — threat analysis, exact resource thresholds, etc.
# Never publish: see docs-for-ai/deployment-security-notes.md
docs-for-ai/
.DS_Store
__pycache__/
.pytest_cache/
.coverage
htmlcov/
.venv/
# Git worktrees live inside the repo here; never commit them as gitlinks
.claude/worktrees/
bills/*
!bills/.gitkeep
!bills/large_bills.csv
# govinfo BILLS bulk-text downloads + staging (fetch_bill_text_archives.py); large, re-fetchable
bills_bulk_text/
bills_govinfo_staging/
# Vendored public-domain (17 U.S.C. 105) govinfo sources for the external-validation suite:
# the Senate reported-bill XML each validation jurisdiction checks. Pinning the exact bytes
# keeps the committed validation_*.json fixtures reproducible and lets the suite run in CI.
# The broader (large) bill corpus stays ignored and is fetched on demand.
!bills/118-s-*/
bills/118-s-*/*
!bills/118-s-*/1_reported-in-senate.xml
# Vendored public-domain (17 U.S.C. 105) PDF fixtures for the glyph-size
# heading-segmentation tests (#89), so they gate CI without fetching: an approps
# House bill (PDF+XML, the FEDERAL PROTECTIVE SERVICE / account-detection case and
# the harness oracle) and a non-approps House bill (PDF, the generalization case).
!bills/118-hr-8752/
bills/118-hr-8752/*
!bills/118-hr-8752/1_reported-in-house.pdf
!bills/118-hr-8752/1_reported-in-house.xml
# v2 (engrossed) PDF + XML too, so the diff-recall suite (13 cross-version cases)
# and the render-examples smoke test (XML v1<->v2 diff) gate CI.
!bills/118-hr-8752/2_engrossed-in-house.pdf
!bills/118-hr-8752/2_engrossed-in-house.xml
!bills/118-hr-8282/
bills/118-hr-8282/*
!bills/118-hr-8282/1_introduced-in-house.pdf
# Committed corpus-manifest fixtures (#217 / ADR 0015): the diff-validation baselines
# (118-hr-4366, 115-hr-5895) and structural-shape coverage (113-hr-3547 enrolled omnibus,
# 119-hr-1 reconciliation) the CI correctness gates run against. Public domain (17 U.S.C.
# 105), immutable, small. Single source of truth: tests/corpus_manifest.toml.
!bills/118-hr-4366/
bills/118-hr-4366/*
!bills/118-hr-4366/1_reported-in-house.xml
!bills/118-hr-4366/2_engrossed-in-house.xml
!bills/118-hr-4366/4_engrossed-amendment-senate.xml
!bills/118-hr-4366/5_engrossed-amendment-house.xml
!bills/118-hr-4366/6_enrolled-bill.xml
!bills/115-hr-5895/
bills/115-hr-5895/*
!bills/115-hr-5895/4_engrossed-amendment-senate.xml
!bills/115-hr-5895/5_enrolled-bill.xml
# The enrolled PDF too (#141): the smallest enrolled print in the corpus, and the
# fixture the unnumbered-layout decline guard is gated on. Enrolled bills carry no
# GPO margin line numbers, so this is the shape that used to diff silently wrong.
!bills/115-hr-5895/5_enrolled-bill.pdf
!bills/113-hr-3547/
bills/113-hr-3547/*
!bills/113-hr-3547/6_enrolled-bill.xml
!bills/119-hr-1/
bills/119-hr-1/*
!bills/119-hr-1/1_reported-in-house.xml
reports/*
!reports/.gitkeep
plans/
test_data/*
!test_data/validation_*.json
# Hand-labeled similarity-threshold answer key (DeltaTrack #8); regen: scripts/build_similarity_labels.py
!test_data/similarity_labels.json
!test_data/pdf/
# Vendored committee-report HTML (public domain) — the external-validation ground-truth source.
!test_data/CRPT-*.htm
# Persistent PDF extraction cache (developer test-loop speedup; see tests/pdf_corpus.py)
test_data/extract_cache/
*.csv
# Vendored GPO render chain (public domain, ~2.2MB incl. binary JPGs) — local reference only.
# Mined into docs/gpo-render-conventions.md; re-fetch from govinfo bulkdata when needed. See DeltaTrack#40.
reference/
# govinfo-derived test corpus for provision-matching research (#170); large, re-derivable
bills_corpus/

# Generated research render (regenerate via probes/build_artifact.py)
docs/research/provision-matching/paper.html

# Pass 2 (#203) derived mining artifacts — large, re-derivable from bills_corpus/ via the mine_*.py
# probes; they also embed gitignored corpus text. The miners are committed; these regenerate.
docs/research/provision-matching/probes/idf_cache.json
docs/research/provision-matching/probes/candidates_*.json
docs/research/provision-matching/probes/split_assignment.json

# Pass 2 (#203) labeling artifacts — generated per run from the mined candidate pools; they carry
# stratum/split (worklist) or in-progress labels, so they are re-derivable and not committed. The
# self-contained HTML form TEMPLATE is committed; the per-reviewer forms are not.
docs/research/provision-matching/probes/worklist.json
docs/research/provision-matching/probes/worklist_sample.md
docs/research/provision-matching/probes/assignments.json
docs/research/provision-matching/probes/form_*.html
!docs/research/provision-matching/probes/form_template.html
docs/research/provision-matching/probes/labels/
docs/research/provision-matching/probes/merged_labels.json
